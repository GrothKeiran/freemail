# ===== Worker 侧 =====
MAIL_DOMAIN=temp.example.com
BACKEND_BASE_URL=https://mail-api.example.com
BRIDGE_API_TOKEN=change-me-to-a-long-random-string

# 前端登录与会话
ADMIN_NAME=admin
ADMIN_PASSWORD=change-me
JWT_TOKEN=change-me-jwt-secret
GUEST_PASSWORD=
SESSION_EXPIRE_DAYS=7

# 发件（可选）
RESEND_API_KEY=
FORWARD_RULES=

# ===== 自建后端侧 =====
PORT=8788
STORAGE_ROOT=/www/wwwroot/freemail/data/mail-storage
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=freemail
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=freemail
MYSQL_CONNECTION_LIMIT=10
